PORT=3000
AUTOMATION_PORT=3001
NODE_ENV=development

# Chromium instances the capture queue keeps in flight. Default 2.
MAX_CONCURRENT_CAPTURES=2

# Turso. The service will not start without both.
DATABASE_URL=libsql://...
DATABASE_AUTH_TOKEN=...

# better-auth. It only WARNS about a missing secret in development and THROWS in
# production, so leaving these out fails on deploy and nowhere else.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=...
BETTER_AUTH_URL=https://api-automation.vour.dev

# The one provider availableModels() will hand out. See "Models: OmniRoute only"
# in CLAUDE.md before adding a second one — a stray key here once outranked
# OmniRoute and took the default with no fallback at all.
OMNIROUTE_API_KEY=...
OMNIROUTE_BASE_URL=...
OMNIROUTE_COMBO=vour-combos

# Optional, and NOT a second generation provider. Only lib/topics/generator.ts
# uses it, for one Google Search grounded call that fetches current dev trends —
# a capability OmniRoute does not offer. Absent, that pass returns null and topic
# generation continues without trend context.
GOOGLE_GENERATIVE_AI_API_KEY=

CLOUDINARY_URL=cloudinary://...
BUFFER_TOKEN=...
# Without at least one of these, /automation/generate answers 500.
BUFFER_IG_CHANNEL_ID=...
BUFFER_TIKTOK_CHANNEL_ID=...

# X-API-Key that port 3001 checks. n8n sends this.
AUTOMATION_SECRET=...
# Comma-separated. In development an unmatched origin is reflected back; in
# production only this list is allowed.
ALLOWED_ORIGIN=http://localhost:3000

# Only ever set for `npm run seed`, never for the running server — it is what
# re-enables signup long enough to create the operator account.
# ALLOW_SIGNUP=true
