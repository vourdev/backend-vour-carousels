{
  "name": "backend-vour-carousels",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/server.js --format=esm --external:playwright --external:@libsql/client --external:better-auth && mkdir -p dist/lib/ds/assets && cp -R src/lib/ds/assets/ dist/lib/ds/assets/",
    "start": "node dist/server.js",
    "test:regression": "tsx scripts/verify-regression.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.11",
    "@ai-sdk/google": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.10",
    "@hono/node-server": "^1.13.7",
    "@libsql/client": "^0.17.4",
    "@libsql/kysely-libsql": "^0.4.1",
    "ai": "^7.0.28",
    "better-auth": "^1.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "hono": "^4.6.15",
    "html-to-image": "^1.11.13",
    "kysely": "^0.27.4",
    "playwright": "^1.61.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.2.18",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
